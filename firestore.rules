rules_version = '2';

// ================================================================
//  REGLAS CON AUTENTICACIÓN (login con Google).
//  Requieren sesión iniciada como rominadehesa@gmail.com para
//  escribir desde el panel. La reserva del paciente NO cambia.
// ================================================================
//
// Modelo actual: la colección "turnos" tiene UN doc por turno que la médica
// carga a mano (fecha y hora, sin paciente = disponible). Reservar = marcar
// ese doc con los datos del paciente + crear un "candado" en "slots" con el
// MISMO ID del doc, para que dos personas no se queden con el mismo horario.

service cloud.firestore {
  match /databases/{database}/documents {

    function esTexto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Cuentas autorizadas (las que se eligen en el popup de Google del panel).
    // Cualquier otro usuario logueado sigue siendo "no admin".
    function esAdmin() {
      return request.auth != null && (
             request.auth.token.email == "rominadehesa@gmail.com"
          || request.auth.token.email == "fornillojulieta3@gmail.com");
    }

    // ---------- 1. turnos: la base única ----------
    match /turnos/{turnoId} {
      function datosDeReservaValidos() {
        let d = request.resource.data;
        return d.fecha == resource.data.fecha        // no se puede cambiar la fecha
            && d.hora == resource.data.hora          // ni la hora del doc
            && esTexto(d.paciente, 1, 100)
            && (!('celular' in d)  || esTexto(d.celular, 0, 30))
            && (!('cobertura' in d) || esTexto(d.cobertura, 0, 200))
            && (!('motivo' in d)   || esTexto(d.motivo, 0, 300));
      }
      function turnoNuevoValido() {
        let d = request.resource.data;
        // Doc nuevo desde el panel: solo fecha y hora, sin paciente.
        return d.keys().hasOnly(['fecha', 'hora'])
            && esTexto(d.fecha, 1, 60)     // la fecha va como texto ("Jueves 05 de Nov")
            && esTexto(d.hora, 4, 5);      // HH:MM
      }
      // Lectura pública: el formulario necesita ver los turnos libres.
      allow read: if true;
      // Crear turnos disponibles: SOLO el panel (médica logueada).
      allow create: if esAdmin() && turnoNuevoValido();
      // Reservar (anónimo con datos válidos) o gestionar estado (médica).
      allow update: if datosDeReservaValidos() || esAdmin();
      // Borrar turnos: SOLO el panel (cancela o elimina registros).
      allow delete: if esAdmin();
    }

    // ---------- 2. slots: el candado anti dobles reservas ----------
    match /slots/{candadoId} {
      function candadoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['fecha', 'hora'])
            && d.keys().hasAll(['fecha', 'hora'])
            && esTexto(d.fecha, 1, 60)   // la fecha va tal como está en el doc
            && esTexto(d.hora, 4, 5);    // HH:MM
      }
      allow read: if true;
      // CREATE solo para docs nuevos: si el candado ya existe, el set()
      // entra como update y esta regla lo niega → falla la reserva doble.
      allow create: if candadoValido();
      // El panel borra el candado al cancelar o eliminar un turno.
      allow delete: if esAdmin();
      // (no hay allow update)
    }

    // ---------- 3. horarios (formato de franjas, por si se usa más adelante) ----------
    match /horarios/{id} {
      allow read: if true;
      // (no hay allow write → se escribe solo desde la consola)
    }
  }
}
